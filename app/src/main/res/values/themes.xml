<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WeAnimals" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/terracotta</item>
    </style>

    <style name="Theme.WeAnimals" parent="Base.Theme.WeAnimals" />

    <style name="Theme.WeAnimals.CropImage" parent="Theme.MaterialComponents.DayNight">
        <item name="android:windowBackground">@color/pine_800</item>
        <item name="android:statusBarColor">@color/pine_800</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/pine_800</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="actionBarStyle">@style/Widget.WeAnimals.CropActionBar</item>
    </style>

    <style name="Widget.WeAnimals.CropActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/pine_800</item>
        <item name="backgroundTint">@color/pine_800</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerSize">50%</item>
    </style>
</resources>
