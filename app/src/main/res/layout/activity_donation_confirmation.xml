<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".community.campaign.presentation.DonationConfirmationActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="38dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_donation_confirmation_check"
                android:padding="16dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check" />
            </FrameLayout>

            <TextView
                android:id="@+id/confirmation_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="@color/clay600"
                android:textSize="@dimen/text_size_report_label"
                tools:text="DOAÇÃO · R$ 50" />

            <TextView
                android:id="@+id/confirmation_campaign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_donation_confirmation_campaign"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/clay600"
                android:textSize="@dimen/text_size_details_body"
                tools:text="Arrecadação de ração e cobertores" />

            <TextView
                android:id="@+id/confirmation_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Recebemos sua confirmação" />

            <TextView
                android:id="@+id/confirmation_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink600"
                android:textSize="14sp"
                tools:text="A ONG Patas Unidas vai confirmar o Pix recebido e atualizar o progresso da campanha. Isso costuma levar até 2 dias úteis." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_campaign_info"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="@string/community_donation_registered_now"
                    android:textColor="@color/ink600"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawableStart="@drawable/ic_check_ink"
                    android:drawablePadding="8dp"
                    android:text="@string/community_donation_registered_step_confirmation"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_dot_border"
                    android:drawablePadding="8dp"
                    android:text="@string/community_donation_registered_step_review"
                    android:textColor="@color/ink600"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_dot_border"
                    android:drawablePadding="8dp"
                    android:text="@string/community_donation_registered_step_progress"
                    android:textColor="@color/ink600"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/view_campaign_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/community_donation_registered_view_campaign"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_button"
        android:textStyle="bold"
        app:backgroundTint="@color/clay600"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/back_community_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/community_donation_registered_back_community"
        android:textAllCaps="false"
        android:textColor="@color/ink900"
        android:textSize="@dimen/text_size_button"
        app:backgroundTint="@color/background"
        app:cornerRadius="14dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp" />
</LinearLayout>
