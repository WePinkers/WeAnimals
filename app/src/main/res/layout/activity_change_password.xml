<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/change_password_header"
            layout="@layout/view_screen_header" />

        <ScrollView
            android:id="@+id/change_password_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Informe sua senha atual e escolha uma nova senha para a conta."
                    android:textColor="@color/ink600"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="SENHA ATUAL"
                    android:textColor="@color/ink600"
                    android:textSize="11sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/current_password_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_entry_input"
                        android:hint="Digite sua senha atual"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="48dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink600"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/current_password_toggle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@android:color/transparent"
                        android:contentDescription="Mostrar senha"
                        android:padding="12dp"
                        android:src="@drawable/ic_visibility_off" />
                </FrameLayout>

                <TextView
                    android:id="@+id/forgot_password_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Esqueci minha senha"
                    android:textColor="@color/terracotta"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="NOVA SENHA"
                    android:textColor="@color/ink600"
                    android:textSize="11sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/new_password_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_entry_input"
                        android:hint="Digite sua nova senha"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="48dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink600"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/new_password_toggle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@android:color/transparent"
                        android:contentDescription="Mostrar senha"
                        android:padding="12dp"
                        android:src="@drawable/ic_visibility_off" />
                </FrameLayout>

                <TextView
                    android:id="@+id/password_strength_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/password_requirements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/requirement_length"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="○  Pelo menos 8 caracteres"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/requirement_uppercase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="○  Uma letra maiúscula"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/requirement_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="○  Um número"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/requirement_symbol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="○  Um símbolo (opcional)"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="CONFIRMAR NOVA SENHA"
                    android:textColor="@color/ink600"
                    android:textSize="11sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/confirm_password_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_entry_input"
                        android:hint="Repita sua nova senha"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="48dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink600"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/confirm_password_toggle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@android:color/transparent"
                        android:contentDescription="Mostrar senha"
                        android:padding="12dp"
                        android:src="@drawable/ic_visibility_off" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/change_password_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Salvar nova senha"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/clay600"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/change_password_success"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_success_circle"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Senha alterada"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sua senha foi atualizada."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back_to_profile_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Voltar ao perfil"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/ink"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
