<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".community.create.presentation.CreateCommunityPostActivity">

    <include
        android:id="@+id/create_header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:id="@+id/create_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_community_tabs"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_community_tab_selected"
                    android:gravity="center"
                    android:text="@string/community_tab_post"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_size_report_chip"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/campaign_tab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/community_tab_campaign"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_report_chip"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_category_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/category_found"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/community_filter_found"
                    android:textSize="@dimen/text_size_report_chip"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipMinHeight="32dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/category_question"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:checkable="true"
                    android:text="@string/community_category_question"
                    android:textSize="@dimen/text_size_report_chip"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipMinHeight="32dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/category_notice"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:text="@string/community_category_notice"
                    android:textSize="@dimen/text_size_report_chip"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipMinHeight="32dp"
                    app:ensureMinTouchTargetSize="false" />
            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/category_other"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="5dp"
                android:checkable="true"
                android:text="@string/community_category_other"
                android:textSize="@dimen/text_size_report_chip"
                app:checkedIconVisible="false"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="32dp"
                app:ensureMinTouchTargetSize="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_photo_optional"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <FrameLayout
                android:id="@+id/photo_dropzone"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_photo_dropzone"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/photo_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/community_post_photo_description"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/photo_prompt_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/clay600" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/add_photo"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_report_body" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_story_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <TextView
                android:id="@+id/story_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textColor="@color/red"
                android:textSize="@dimen/text_size_chat_error"
                android:visibility="gone" />

            <EditText
                android:id="@+id/story_edit"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_report_card"
                android:gravity="top|start"
                android:hint="@string/community_story_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="1000"
                android:padding="12dp"
                android:textColor="@color/ink900"
                android:textColorHint="@color/muted"
                android:textSize="@dimen/text_size_report_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_location_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <FrameLayout
                android:id="@+id/location_card"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_report_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/clay600" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="36dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/location_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/location_detecting"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_location_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/location_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/location_loading"
                        android:textColor="@color/ink600"
                        android:textSize="@dimen/text_size_location_address" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/publish_button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/community_publish"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"
                app:backgroundTint="@color/clay600"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
