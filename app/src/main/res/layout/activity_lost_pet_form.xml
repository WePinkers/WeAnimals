<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:ignore="UnusedResources">

    <!-- Fixed Header Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back_header"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circular_back_btn"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="serif"
                android:text="Perdi meu animal"
                android:textColor="@color/pine800"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/border" />

        <!-- Three Progress Bars -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/progress_segment_1"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_progress_segment_terracotta" />

            <View
                android:id="@+id/progress_segment_2"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_progress_segment_beige" />

            <View
                android:id="@+id/progress_segment_3"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_progress_segment_beige" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_progress_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Passo 1 de 3: o animal"
            android:textColor="@color/muted"
            android:textSize="13sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- ViewFlipper for Step 1, Step 2, and Step 3 -->
    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/step1_layout"
            layout="@layout/include_lost_pet_step1" />

        <include
            android:id="@+id/step2_layout"
            layout="@layout/include_lost_pet_step2" />

        <include
            android:id="@+id/step3_layout"
            layout="@layout/include_lost_pet_step3" />

    </ViewFlipper>

</LinearLayout>
