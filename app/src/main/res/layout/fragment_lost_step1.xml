<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="20dp"
    tools:ignore="UnusedResources">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/step1_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Passo 1 de 3: o animal"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Photo Upload Container -->
        <LinearLayout
            android:id="@+id/container_upload_photo"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dashed_upload"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/photo_preview"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:contentDescription="Preview da foto"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/icon_camera"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_camera"
                app:tint="@color/clay600" />

            <TextView
                android:id="@+id/upload_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Adicionar fotos (quanto mais ângulos, melhor)"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Name Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="NOME (COMO ELE ATENDE)"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_pet_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_stat_card"
            android:hint="Ex.: Pipoca"
            android:inputType="textPersonName"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <!-- Species Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="ESPÉCIE"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_species_dog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected_pine"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Cão"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_species_cat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Gato"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_species_other"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Outro"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Size Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="PORTE"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_size_small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Pequeno"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_size_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected_pine"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Médio"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_size_large"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Grande"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Age Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="IDADE"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_age_puppy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Filhote"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_age_adult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected_pine"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Adulto"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_age_senior"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Idoso"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Breed Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="RAÇA"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_breed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_stat_card"
            android:hint="SRD (sem raça definida)"
            android:inputType="text"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <!-- Footer Button -->
        <Button
            android:id="@+id/btn_continue_step1"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/clay600"
            android:text="Continuar"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
