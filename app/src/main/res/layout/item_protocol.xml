<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground" android:orientation="vertical"
    android:paddingVertical="16dp">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/protocol_number" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink" android:textSize="15sp" />
        <TextView android:id="@+id/protocol_status" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_alignParentEnd="true"
            android:textColor="@color/terracotta" android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>
    <TextView android:id="@+id/protocol_description" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="@color/ink" android:textSize="13sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="16dp" android:background="@color/border" />
</LinearLayout>
