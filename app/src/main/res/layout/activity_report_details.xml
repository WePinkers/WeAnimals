<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".reporting.details.presentation.ReportDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/details_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/view_screen_header" />

    <ScrollView
        android:id="@+id/details_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/details_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/details_protocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:textColor="@color/terracotta"
                android:textSize="@dimen/text_size_details_protocol"
                tools:text="PROTOCOLO #4468" />

            <TextView
                android:id="@+id/details_sent_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_details_meta"
                tools:text="ENVIADA HOJE, 13:02 — NÃO É POSSÍVEL EDITAR APÓS O ENVIO" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/details_photo_label"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_details_label" />

            <FrameLayout
                android:id="@+id/photo_card"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_details_photo"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/photo_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/photo_selected_description"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/photo_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_details_photo"
                    android:textStyle="bold"
                    tools:text="foto-terreno-baldio.jpg" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/details_animal_type_label"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_details_label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/animal_chip"
                android:layout_width="wrap_content"
                android:layout_height="31dp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_details_chip"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                tools:text="Cão" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/details_description_label"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_details_label" />

            <TextView
                android:id="@+id/description_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_details_field"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:paddingStart="12dp"
                android:paddingTop="11dp"
                android:paddingEnd="12dp"
                android:paddingBottom="11dp"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_details_body"
                tools:text="Cão preso em terreno baldio, sem água há pelo menos um dia..." />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/details_location_label"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_details_label" />

            <LinearLayout
                android:id="@+id/location_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_details_field"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_location_pin"
                    android:tint="@color/terracotta" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/location_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_details_location_title"
                        android:textStyle="bold"
                        tools:text="Rua Voluntários, 88" />

                    <TextView
                        android:id="@+id/location_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_size_details_location_subtitle"
                        tools:text="Zona Norte — Rio de Janeiro, RJ" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/details_triage_label"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_details_label" />

            <LinearLayout
                android:id="@+id/triage_answers_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/classification_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/details_classification_label"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_details_label" />

            <LinearLayout
                android:id="@+id/classification_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_triage_classification"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_warning"
                    android:tint="@color/terracotta" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/classification_eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:textColor="@color/terracotta"
                        android:textSize="@dimen/text_size_details_classification_label"
                        android:textStyle="bold"
                        tools:text="MUITO URGENTE" />

                    <TextView
                        android:id="@+id/classification_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="serif"
                        android:includeFontPadding="false"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_details_classification_title"
                        android:textStyle="bold"
                        tools:text="Atendimento em até 15 minutos" />

                    <TextView
                        android:id="@+id/classification_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="1dp"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_size_details_classification_body"
                        tools:text="Maus-tratos ativos e animal ferido detectados. Caso encaminhado com prioridade." />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/details_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/muted"
        android:textSize="@dimen/text_size_details_state"
        android:visibility="gone"
        tools:text="Carregando detalhes..."
        tools:visibility="visible" />
</FrameLayout>
