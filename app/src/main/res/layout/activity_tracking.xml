<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".tracking.presentation.TrackingActivity">

    <ScrollView
        android:id="@+id/tracking_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="88dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="48dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tracking_protocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:textColor="@color/terracotta"
                android:textSize="@dimen/text_size_tracking_protocol"
                tools:text="PROTOCOLO #4468" />

            <TextView
                android:id="@+id/tracking_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_tracking_title"
                android:textStyle="bold"
                tools:text="Cão — Vila Marlene" />

            <TextView
                android:id="@+id/tracking_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_tracking_state"
                android:visibility="gone"
                tools:text="Carregando acompanhamento..."
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/tracking_steps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/details_card"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_tracking_detail_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_document"
                    android:tint="@color/ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/tracking_details_card"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_tracking_card_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/tracking_details_hint"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_size_tracking_card_body" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/update_card"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tracking_detail_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_warning"
                    android:tint="@color/terracotta" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/tracking_update_card"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_tracking_card_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/tracking_update_hint"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_size_tracking_card_body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_home"
                android:tint="@color/muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/nav_home"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_navigation" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/nav_map"
                android:src="@drawable/ic_map"
                android:tint="@color/muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/nav_map"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_navigation" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/nav_community"
                android:src="@drawable/ic_community"
                android:tint="@color/muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/nav_community"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_navigation" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/nav_adoption"
                android:src="@drawable/ic_paw"
                android:tint="@color/muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/nav_adoption"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_navigation" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/nav_profile"
                android:src="@drawable/ic_profile"
                android:tint="@color/muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/nav_profile"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_navigation" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
