<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".reporting.report.presentation.sent.ReportSentActivity">

    <ScrollView
        android:id="@+id/sent_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="140dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="48dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/success_icon_container"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_success_circle"
                android:contentDescription="@string/success_icon_description"
                android:foregroundGravity="center">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription=""
                    android:padding="7dp"
                    android:src="@drawable/ic_check"
                    android:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/sent_protocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:textColor="@color/terracotta"
                android:textSize="@dimen/text_size_sent_protocol"
                tools:text="PROTOCOLO #4472" />

            <TextView
                android:id="@+id/sent_classification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_sent_classification"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/terracotta_dark"
                android:textSize="@dimen/text_size_sent_classification"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sent_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="@string/sent_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_sent_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sent_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="@string/sent_description"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_sent_body" />

            <LinearLayout
                android:id="@+id/status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_status_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="@string/what_happens_now"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_sent_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_status_active_dot" />

                    <TextView
                        android:id="@+id/review_step"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/case_review"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_sent_step"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_status_pending_dot" />

                    <TextView
                        android:id="@+id/assigned_step"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/case_assigned"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_size_sent_step" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_status_pending_dot" />

                    <TextView
                        android:id="@+id/rescue_step"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/rescue_forwarded"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_size_sent_step" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/sent_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/follow_case_button"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:backgroundTint="@color/terracotta"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/follow_case"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_sent_button"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_home_button"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/background"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/back_home"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_size_sent_button"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
