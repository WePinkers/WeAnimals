<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:ignore="UnusedResources">

    <include
        android:id="@+id/screen_header"
        layout="@layout/view_screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="86dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Responda para confirmar que este é o seu animal. Só quem encontrou vê suas respostas."
                android:textColor="@color/ink600"
                android:textSize="13.5sp" />

            <!-- Form Field 1: Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="1. QUAL É O NOME DO ANIMAL?"
                android:textColor="@color/ink600"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_pet_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_stat_card"
                android:hint="Ex.: Toby"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/pine900"
                android:textColorHint="@color/ink600"
                android:textSize="14sp" />

            <!-- Form Field 2: Secret Mark -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="2. QUAL MARCA OU DETALHE SÓ VOCÊ SABERIA?"
                android:textColor="@color/ink600"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_secret_mark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_stat_card"
                android:gravity="top|start"
                android:hint="Ex.: mancha em formato de coração na pata"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="@color/pine900"
                android:textColorHint="@color/ink600"
                android:textSize="14sp" />

            <!-- Form Field 3: Proof Photo (Optional) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="3. FOTO DE COMPROVAÇÃO (OPCIONAL)"
                android:textColor="@color/ink600"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/container_upload_proof"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dashed_upload"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/proof_photo_preview"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Foto de comprovação"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/icon_camera"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/clay600" />

                <TextView
                    android:id="@+id/upload_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Adicionar uma foto antiga do animal"
                    android:textColor="@color/pine900"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Privacy Notice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock_outline"
                    app:tint="@color/ink600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Seu contato só é compartilhado depois que a pessoa aceitar as respostas."
                    android:textColor="@color/ink600"
                    android:textSize="10.5sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Footer Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <Button
            android:id="@+id/btn_submit_verification"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/clay600"
            android:text="Enviar respostas"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
