<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".community.detail.presentation.CommunityPostDetailActivity">

    <include
        android:id="@+id/post_header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/post_avatar"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_community_avatar"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_card_title"
                            android:textStyle="bold"
                            tools:text="M" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/post_author"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_size_card_title"
                                android:textStyle="bold"
                                tools:text="Marta Nunes" />

                            <TextView
                                android:id="@+id/post_meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink600"
                                android:textSize="@dimen/text_size_card_protocol"
                                tools:text="há 2h · Vila Marlene" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/post_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/ink600"
                        android:textSize="@dimen/text_size_report_body"
                        tools:text="Achei essa gatinha perto da praça, parece bem cuidada mas está sem coleira. Alguém reconhece?" />

                    <ImageView
                        android:id="@+id/post_photo"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="10dp"
                        android:contentDescription="@string/community_post_photo_description"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/post_like_action"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="4dp">

                            <ImageView
                                android:id="@+id/post_like_icon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@string/community_like"
                                android:src="@drawable/ic_heart_outline"
                                app:tint="@color/muted" />

                            <TextView
                                android:id="@+id/post_likes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/ink600"
                                android:textSize="@dimen/text_size_card_protocol" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/post_comment_action"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="4dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@string/community_comment"
                                android:src="@drawable/ic_community_comment" />

                            <TextView
                                android:id="@+id/post_comments"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/ink600"
                                android:textSize="@dimen/text_size_card_protocol" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/comments_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_report_label"
                android:textStyle="bold"
                tools:text="7 COMENTÁRIOS" />

            <TextView
                android:id="@+id/comments_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_body"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/comments_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/comment_input"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:hint="@string/community_comment_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ink900"
            android:textColorHint="@color/muted"
            android:textSize="@dimen/text_size_chat_input" />

        <ImageButton
            android:id="@+id/send_comment_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chat_send"
            android:contentDescription="@string/community_send_comment"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            android:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
