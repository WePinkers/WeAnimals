<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:ignore="UnusedResources">

    <include
        android:id="@+id/screen_header"
        layout="@layout/view_screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Não encontrou o que procurava? Envie sua pergunta e a equipe responde. Perguntas recorrentes podem entrar nesta lista."
            android:textColor="@color/ink600"
            android:textSize="13.5sp" />

        <!-- Category Dropdown -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="CATEGORIA"
            android:textColor="@color/ink600"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_stat_card"
            android:paddingHorizontal="12dp" />

        <!-- Question Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="SUA PERGUNTA"
            android:textColor="@color/ink600"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_stat_card"
            android:gravity="top|start"
            android:hint="Escreva aqui sua dúvida..."
            android:inputType="textMultiLine"
            android:maxLength="500"
            android:minLines="4"
            android:padding="14dp"
            android:textColor="@color/pine900"
            android:textColorHint="@color/ink600"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/char_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="0/500"
            android:textColor="@color/ink600"
            android:textSize="11sp" />

        <!-- Notification Checkbox -->
        <CheckBox
            android:id="@+id/check_notify_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="Quero ser avisado por notificação quando minha pergunta for respondida."
            android:textColor="@color/pine900"
            android:textSize="13sp" />

        <!-- Footer Button -->
        <Button
            android:id="@+id/btn_submit_question"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/pine800"
            android:text="Enviar pergunta"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
