<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="20dp"
    tools:ignore="UnusedResources">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrow_back"
                app:tint="#132A20" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            android:text="Enviar pergunta"
            android:textColor="#132A20"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Não encontrou o que procurava? Envie sua pergunta e a equipe responde. Perguntas recorrentes podem entrar nesta lista."
            android:textColor="#5C5548"
            android:textSize="13.5sp" />

        <!-- Category Dropdown -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="CATEGORIA"
            android:textColor="#5C5548"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_stat_card"
            android:paddingHorizontal="12dp" />

        <!-- Question Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="SUA PERGUNTA"
            android:textColor="#5C5548"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_stat_card"
            android:gravity="top|start"
            android:hint="Escreva aqui sua dúvida..."
            android:inputType="textMultiLine"
            android:maxLength="500"
            android:minLines="4"
            android:padding="14dp"
            android:textColor="#132A20"
            android:textColorHint="#5C5548"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/char_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="0/500"
            android:textColor="#5C5548"
            android:textSize="11sp" />

        <!-- Notification Checkbox -->
        <CheckBox
            android:id="@+id/check_notify_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="Quero ser avisado por notificação quando minha pergunta for respondida."
            android:textColor="#132A20"
            android:textSize="13sp" />

        <!-- Footer Button -->
        <Button
            android:id="@+id/btn_submit_question"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#1F3D2E"
            android:text="Enviar pergunta"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
