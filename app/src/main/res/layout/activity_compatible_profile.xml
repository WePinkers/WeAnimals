<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".adoption.compatibility.presentation.CompatibleProfileActivity">

    <include
        android:id="@+id/compatible_profile_header"
        layout="@layout/view_screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/profile_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/compatible_profile_summary_icon_size"
                            android:layout_height="@dimen/compatible_profile_summary_icon_size"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_adoption_photo_marker"
                            app:tint="@color/terracotta" />

                        <TextView
                            android:id="@+id/size_profile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/compatible_profile_summary_text_spacing"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_size_compatible_profile_item"
                            android:textStyle="bold"
                            tools:text="Porte pequeno a médio" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/compatible_profile_summary_item_spacing"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/compatible_profile_summary_icon_size"
                            android:layout_height="@dimen/compatible_profile_summary_icon_size"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_adoption_heart"
                            app:tint="@color/terracotta" />

                        <TextView
                            android:id="@+id/temperament_profile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/compatible_profile_summary_text_spacing"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_size_compatible_profile_item"
                            android:textStyle="bold"
                            tools:text="Temperamento calmo e independente" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/compatible_profile_summary_item_spacing"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/compatible_profile_summary_icon_size"
                            android:layout_height="@dimen/compatible_profile_summary_icon_size"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_energy"
                            app:tint="@color/terracotta" />

                        <TextView
                            android:id="@+id/energy_profile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/compatible_profile_summary_text_spacing"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_size_compatible_profile_item"
                            android:textStyle="bold"
                            tools:text="Nível de energia moderado" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/compatible_profile_summary_item_spacing"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/compatible_profile_summary_icon_size"
                            android:layout_height="@dimen/compatible_profile_summary_icon_size"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_clock"
                            app:tint="@color/terracotta" />

                        <TextView
                            android:id="@+id/age_profile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/compatible_profile_summary_text_spacing"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_size_compatible_profile_item"
                            android:textStyle="bold"
                            tools:text="Adulto (1 a 5 anos)" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/profile_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_compatible_profile_description"
                    tools:text="Com base na sua rotina (home office) e no espaço disponível (apto com varanda), estes animais apresentam maior chance de adaptação ao seu perfil." />

                <TextView
                    android:id="@+id/edit_questionnaire_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:minHeight="28dp"
                    android:gravity="center_vertical"
                    android:text="@string/compatible_profile_edit_answers"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_compatible_edit_link" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:text="@string/compatible_profile_recommendations"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_eyebrow" />

                <LinearLayout
                    android:id="@+id/recommendations_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/recommendations_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/compatible_profile_empty"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_size_compatible_state"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/profile_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="36dp">

            <ProgressBar
                android:id="@+id/profile_progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/adoption_primary" />

            <TextView
                android:id="@+id/profile_state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/compatible_profile_loading"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_compatible_state"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_state_action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/terracotta"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="@string/compatible_profile_retry"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
