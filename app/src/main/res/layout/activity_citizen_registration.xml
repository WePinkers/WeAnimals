<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".entry.presentation.CitizenRegistrationActivity">

    <include
        android:id="@+id/register_header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_entry_info"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield_outline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/register_cpf_info_title"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_size_report_body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/register_cpf_info_body"
                    android:textColor="@color/ink600"
                    android:textSize="@dimen/text_size_report_label" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/register_name_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="@string/register_name_label"
            android:textColor="@color/ink600"
            android:textSize="@dimen/text_size_report_label" />

        <EditText
            android:id="@+id/register_name_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_entry_input"
            android:hint="@string/register_name_hint"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink600"
            android:textSize="@dimen/text_size_report_body" />

        <TextView
            android:id="@+id/register_cpf_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="@string/register_cpf_label"
            android:textColor="@color/ink600"
            android:textSize="@dimen/text_size_report_label" />

        <EditText
            android:id="@+id/register_cpf_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_entry_input"
            android:hint="@string/register_cpf_hint"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink600"
            android:textSize="@dimen/text_size_report_body" />

        <TextView
            android:id="@+id/register_email_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="@string/register_email_label"
            android:textColor="@color/ink600"
            android:textSize="@dimen/text_size_report_label" />

        <EditText
            android:id="@+id/register_email_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_entry_input"
            android:hint="@string/register_email_hint"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink600"
            android:textSize="@dimen/text_size_report_body" />

        <TextView
            android:id="@+id/register_password_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="@string/register_password_label"
            android:textColor="@color/ink600"
            android:textSize="@dimen/text_size_report_label" />

        <EditText
            android:id="@+id/register_password_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_entry_input"
            android:hint="@string/register_password_hint"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink600"
            android:textSize="@dimen/text_size_report_body" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/legal_acceptance_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:buttonTint="@color/pine700"
            android:minHeight="48dp"
            android:text="@string/legal_acceptance_checkbox"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_size_location_address" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/register_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/register_button"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            app:backgroundTint="@color/clay600"
            app:cornerRadius="14dp" />

        <TextView
            android:id="@+id/terms_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:text="@string/register_terms"
            android:textColor="@color/ink600"
            android:textSize="@dimen/text_size_location_address" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
