<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/organization_detail_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/view_screen_header" />

        <LinearLayout
            android:id="@+id/organization_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/organization_urgent_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_org_urgent_card"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:padding="10dp">
                <ImageView
                    android:id="@+id/organization_detail_urgency_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_warning"
                    android:tint="@color/alert600" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/organization_detail_urgency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/alert600"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/organization_detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="serif"
                        android:textColor="@color/ink"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/organization_detail_location_label"
                android:textColor="@color/muted"
                android:textSize="9sp" />

            <FrameLayout
                android:id="@+id/organization_detail_map"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_map_preview"
                android:clipToOutline="true">
                <org.maplibre.android.maps.MapView
                    android:id="@+id/organization_detail_map_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/organization_detail_map_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_map_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:text="@string/organization_detail_map_expand"
                    android:textColor="@color/ink900"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/organization_detail_map_attribution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="#E6FFFFFF"
                    android:clickable="true"
                    android:contentDescription="@string/map_attribution"
                    android:focusable="true"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="@string/map_attribution"
                    android:textColor="@color/ink900"
                    android:textSize="7sp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/organization_detail_description_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_org_action_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="70dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_document"
                    android:tint="@color/terracotta" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/organization_detail_open_description"
                        android:textColor="@color/ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/organization_detail_description_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ink" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/organization_detail_status_label"
                android:textColor="@color/muted"
                android:textSize="9sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/organization_status_options"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/organization_status_called"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:text="@string/organization_status_called"
                        android:textAllCaps="false"
                        android:textSize="10sp"
                        app:cornerRadius="20dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/organization_status_on_way"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:text="@string/organization_status_on_way"
                        android:textAllCaps="false"
                        android:textSize="10sp"
                        app:cornerRadius="20dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/organization_status_rescue"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:text="@string/organization_status_rescue"
                        android:textAllCaps="false"
                        android:textSize="10sp"
                        app:cornerRadius="20dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/organization_status_shelter"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:text="@string/organization_status_shelter"
                        android:textAllCaps="false"
                        android:textSize="10sp"
                        app:cornerRadius="20dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/organization_detail_agent_label"
                android:textColor="@color/muted"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/organization_detail_agent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_details_field"
                android:padding="13dp"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/organization_detail_status_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
