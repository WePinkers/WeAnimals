<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:ignore="UnusedResources">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circular_white_button"
            android:contentDescription="Voltar"
            android:elevation="1dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/pine900" />

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_flowbar_active"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_headset"
                app:tint="@color/white" />

            <View
                android:id="@+id/online_indicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_chip_selected_pine" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_agent_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Atendimento WeAnimals"
                android:textColor="@color/pine900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="● Online"
                android:textColor="@color/pine700"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Messages Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_support_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp" />

    </FrameLayout>

    <!-- Quick Replies & Rating & Composer Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <!-- Rating Card (Displayed when ended) -->
        <LinearLayout
            android:id="@+id/card_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_stat_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Como foi seu atendimento?"
                android:textColor="@color/pine900"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/star1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="★"
                    android:textColor="@color/brass500"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/star2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="★"
                    android:textColor="@color/brass500"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/star3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="★"
                    android:textColor="@color/brass500"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/star4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="★"
                    android:textColor="@color/brass500"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/star5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="★"
                    android:textColor="@color/brass500"
                    android:textSize="24sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/input_rating_comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:hint="Deixe um comentário (opcional)"
                android:inputType="text"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:textColor="@color/pine900"
                android:textColorHint="@color/ink600"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_submit_rating"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/pine800"
                android:text="Enviar avaliação"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <TextView
                android:id="@+id/btn_new_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:text="Iniciar nova conversa"
                android:textColor="@color/pine700"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Reply Chips -->
        <HorizontalScrollView
            android:id="@+id/quick_replies_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_qr_report"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Denúncia de animal"
                    android:textColor="@color/pine800"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_qr_adoption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Adoção"
                    android:textColor="@color/pine800"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_qr_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Minha conta"
                    android:textColor="@color/pine800"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_qr_scams"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Golpe ou cobrança"
                    android:textColor="@color/pine800"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_qr_other"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Outro assunto"
                    android:textColor="@color/pine800"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Safety Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_secret_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield_outline"
                app:tint="@color/clay600" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Atendimento oficial WeAnimals. Nunca pedimos senha ou transferências financeiras."
                android:textColor="@color/pine900"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Input Row -->
        <LinearLayout
            android:id="@+id/input_row_container"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_attach_file"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Anexar"
                android:padding="6dp"
                android:src="@drawable/ic_document"
                app:tint="@color/ink600" />

            <EditText
                android:id="@+id/input_support_message"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:gravity="center_vertical"
                android:hint="Escreva sua mensagem…"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textColor="@color/pine900"
                android:textColorHint="@color/ink600"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_send_support"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_selected_pine"
                android:contentDescription="Enviar"
                android:padding="8dp"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
