<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/sand50"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/community_campaign_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/campaign_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_community_search"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_community_neutering"
                app:tint="@color/clay600" />

            <TextView
                android:id="@+id/campaign_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textColor="@color/clay600"
                android:textSize="@dimen/text_size_badge"
                tools:text="CASTRAÇÃO · ABRIGO ESPERANÇA" />
        </LinearLayout>

        <TextView
            android:id="@+id/campaign_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_size_report_title"
            android:textStyle="bold"
            tools:text="Castração gratuita – mutirão de sábado" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar_outline" />

            <TextView
                android:id="@+id/campaign_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_details_body"
                tools:text="Sáb, 6 set · 8h às 13h" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location_pin" />

            <TextView
                android:id="@+id/campaign_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_details_body"
                tools:text="Vila Marlene · 2,3 km" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/campaign_progress_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/campaign_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_report_label"
                tools:text="VAGAS PREENCHIDAS" />

            <ProgressBar
                android:id="@+id/campaign_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progressBackgroundTint="@color/border"
                android:progressTint="@color/clay600" />

            <TextView
                android:id="@+id/campaign_progress_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_details_body"
                tools:text="28 de 60 vagas preenchidas · 32 restantes" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/campaign_availability"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_community_availability"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="@color/clay600"
                android:textSize="@dimen/text_size_details_body"
                tools:text="32 vagas restantes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/campaign_join"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/community_join"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_button"
                app:backgroundTint="@color/clay600"
                app:cornerRadius="22dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
