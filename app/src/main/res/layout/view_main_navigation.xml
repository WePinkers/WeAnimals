<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:baselineAligned="false"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_home_icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_home"
            app:tint="@color/muted" />

        <TextView
            android:id="@+id/nav_home_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/nav_home"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_size_navigation"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_map"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_map_icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="@string/nav_map"
            android:src="@drawable/ic_map"
            app:tint="@color/muted" />

        <TextView
            android:id="@+id/nav_map_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/nav_map"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_size_navigation" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_community"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_community_icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="@string/nav_community"
            android:src="@drawable/ic_community"
            app:tint="@color/muted" />

        <TextView
            android:id="@+id/nav_community_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/nav_community"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_size_navigation" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_adoption"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_adoption_icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="@string/nav_adoption"
            android:src="@drawable/ic_paw"
            app:tint="@color/muted" />

        <TextView
            android:id="@+id/nav_adoption_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/nav_adoption"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_size_navigation" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_profile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_profile_icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="@string/nav_profile"
            android:src="@drawable/ic_profile"
            app:tint="@color/muted" />

        <TextView
            android:id="@+id/nav_profile_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/nav_profile"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_size_navigation" />
    </LinearLayout>
</LinearLayout>
