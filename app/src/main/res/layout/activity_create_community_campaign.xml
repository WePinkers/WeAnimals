<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".community.campaign.presentation.CreateCommunityCampaignActivity">

    <include
        android:id="@+id/campaign_header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:id="@+id/campaign_create_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_campaign_type_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/category_neutering"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:text="@string/community_filter_neutering"
                    android:textSize="@dimen/text_size_report_chip"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipMinHeight="32dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/category_vaccination"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:checkable="true"
                    android:text="@string/community_filter_vaccination"
                    android:textSize="@dimen/text_size_report_chip"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipMinHeight="32dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/category_adoption"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:checkable="true"
                    android:text="@string/community_campaign_adoption"
                    android:textSize="@dimen/text_size_report_chip"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipMinHeight="32dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/category_donation"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:checkable="true"
                    android:text="@string/community_campaign_donation"
                    android:textSize="@dimen/text_size_report_chip"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipMinHeight="32dp"
                    app:ensureMinTouchTargetSize="false" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_campaign_title_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <EditText
                android:id="@+id/title_edit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_report_card"
                android:hint="@string/community_campaign_title_hint"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink900"
                android:textColorHint="@color/muted"
                android:textSize="@dimen/text_size_report_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_campaign_date_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <EditText
                android:id="@+id/date_edit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_report_card"
                android:hint="@string/community_campaign_date_hint"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink900"
                android:textColorHint="@color/muted"
                android:textSize="@dimen/text_size_report_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_location_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <FrameLayout
                android:id="@+id/location_card"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_report_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/clay600" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="36dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/location_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/location_detecting"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_location_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/location_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/location_loading"
                        android:textColor="@color/ink600"
                        android:textSize="@dimen/text_size_location_address" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_campaign_availability_input_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <EditText
                android:id="@+id/availability_edit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_report_card"
                android:hint="@string/community_campaign_availability_hint"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink900"
                android:textColorHint="@color/muted"
                android:textSize="@dimen/text_size_report_body" />

            <LinearLayout
                android:id="@+id/neutering_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="@string/community_campaign_total_slots_label"
                    android:textColor="@color/ink600"
                    android:textSize="@dimen/text_size_report_label" />

                <EditText
                    android:id="@+id/total_slots_edit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_report_card"
                    android:hint="@string/community_campaign_total_slots_hint"
                    android:inputType="number"
                    android:maxLength="6"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ink900"
                    android:textColorHint="@color/muted"
                    android:textSize="@dimen/text_size_report_body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/donation_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="@string/community_campaign_donation_goal_label"
                    android:textColor="@color/ink600"
                    android:textSize="@dimen/text_size_report_label" />

                <EditText
                    android:id="@+id/donation_goal_edit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_report_card"
                    android:hint="@string/community_campaign_donation_goal_hint"
                    android:inputType="numberDecimal"
                    android:maxLength="14"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ink900"
                    android:textColorHint="@color/muted"
                    android:textSize="@dimen/text_size_report_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="@string/community_campaign_pix_key_label"
                    android:textColor="@color/ink600"
                    android:textSize="@dimen/text_size_report_label" />

                <EditText
                    android:id="@+id/pix_key_edit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_report_card"
                    android:hint="@string/community_campaign_pix_key_hint"
                    android:inputType="textEmailAddress"
                    android:maxLength="200"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ink900"
                    android:textColorHint="@color/muted"
                    android:textSize="@dimen/text_size_report_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="@string/community_campaign_donation_needs_label"
                    android:textColor="@color/ink600"
                    android:textSize="@dimen/text_size_report_label" />

                <EditText
                    android:id="@+id/donation_needs_edit"
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_report_card"
                    android:gravity="top|start"
                    android:hint="@string/community_campaign_donation_needs_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="600"
                    android:padding="12dp"
                    android:textColor="@color/ink900"
                    android:textColorHint="@color/muted"
                    android:textSize="@dimen/text_size_report_body" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_campaign_audience_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <EditText
                android:id="@+id/audience_edit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_report_card"
                android:hint="@string/community_campaign_audience_hint"
                android:inputType="textCapSentences"
                android:maxLength="160"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink900"
                android:textColorHint="@color/muted"
                android:textSize="@dimen/text_size_report_body" />

            <LinearLayout
                android:id="@+id/confirmed_animals_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="@string/community_campaign_confirmed_animals_label"
                    android:textColor="@color/ink600"
                    android:textSize="@dimen/text_size_report_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/community_campaign_confirmed_animals_helper"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_details_body" />

                <LinearLayout
                    android:id="@+id/confirmed_animals_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_confirmed_animal_button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/community_campaign_add_animal"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_size_button"
                    app:backgroundTint="@color/surface"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_campaign_highlight_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <EditText
                android:id="@+id/highlight_edit"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_report_card"
                android:gravity="top|start"
                android:hint="@string/community_campaign_highlight_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="240"
                android:padding="12dp"
                android:textColor="@color/ink900"
                android:textColorHint="@color/muted"
                android:textSize="@dimen/text_size_report_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_campaign_description_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <EditText
                android:id="@+id/description_edit"
                android:layout_width="match_parent"
                android:layout_height="122dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_report_card"
                android:gravity="top|start"
                android:hint="@string/community_campaign_description_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="1200"
                android:padding="12dp"
                android:textColor="@color/ink900"
                android:textColorHint="@color/muted"
                android:textSize="@dimen/text_size_report_body" />

            <TextView
                android:id="@+id/form_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/red"
                android:textSize="@dimen/text_size_chat_error"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/publish_campaign_button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/community_campaign_publish"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"
                app:backgroundTint="@color/clay600"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
