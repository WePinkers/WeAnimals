<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".adoption.confirmation.presentation.AdoptionConfirmationActivity">

    <include
        android:id="@+id/confirmation_header"
        layout="@layout/view_screen_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/confirmation_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="18dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_status_card"
                            android:clipToOutline="true">

                            <ImageView
                                android:id="@+id/candidate_photo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop" />

                            <ImageView
                                android:id="@+id/candidate_photo_placeholder"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_adoption_photo_marker" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/candidate_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:includeFontPadding="false"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_size_adoption_confirmation_name"
                                android:textStyle="bold"
                                tools:text="Nome do animal" />

                            <TextView
                                android:id="@+id/candidate_meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:textColor="@color/muted"
                                android:textSize="@dimen/text_size_adoption_confirmation_meta"
                                tools:text="SRD · 2 anos · Abrigo Esperança" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/candidate_match"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:includeFontPadding="false"
                                android:textColor="@color/adoption_primary"
                                android:textSize="@dimen/text_size_adoption_confirmation_match"
                                android:textStyle="bold"
                                tools:text="74%" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:fontFamily="monospace"
                                android:text="@string/compatible_profile_match_label"
                                android:textColor="@color/muted"
                                android:textSize="@dimen/text_size_compatible_match_label" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.07"
                    android:text="@string/adoption_confirmation_steps_label"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_eyebrow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:paddingStart="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/adoption_confirmation_step_submit"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_adoption_confirmation_step_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/adoption_confirmation_step_submit_body"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_size_adoption_confirmation_step_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/adoption_confirmation_step_review"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_adoption_confirmation_step_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/review_step_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_size_adoption_confirmation_step_body"
                        tools:text="Pode haver mais de um candidato interessado neste animal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/adoption_confirmation_step_visit"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_adoption_confirmation_step_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/adoption_confirmation_step_visit_body"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_size_adoption_confirmation_step_body" />
                </LinearLayout>

                <TextView
                    android:id="@+id/candidacy_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_status_card"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:padding="12dp"
                    android:text="@string/adoption_confirmation_note"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_adoption_confirmation_note" />

                <TextView
                    android:id="@+id/submit_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/terracotta_dark"
                    android:textSize="@dimen/text_size_adoption_confirmation_note"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submit_application_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="48dp"
                    android:text="@string/adoption_confirmation_submit"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_button"
                    android:textStyle="bold"
                    app:backgroundTint="@color/terracotta"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/confirmation_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ProgressBar
                android:id="@+id/confirmation_progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/adoption_primary" />

            <TextView
                android:id="@+id/confirmation_state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/adoption_confirmation_loading"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_compatible_state"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmation_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/adoption_retry"
                android:textAllCaps="false"
                android:visibility="gone"
                app:backgroundTint="@color/adoption_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
