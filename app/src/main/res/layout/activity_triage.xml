<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".triage.presentation.TriageActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="@string/back"
                android:padding="7dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="@string/triage_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_report_title"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="@string/triage_protocol_intro"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_triage_protocol" />

            <ImageButton
                android:id="@+id/triage_info_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/triage_info_title"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                android:tint="@color/muted" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/triage_immediate_danger"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_size_triage_question"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/immediate_danger_yes_button"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:backgroundTint="@color/surface"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/triage_yes"
                android:textAllCaps="false"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_triage_choice"
                app:cornerRadius="18dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/immediate_danger_no_button"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/surface"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/triage_no"
                android:textAllCaps="false"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_triage_choice"
                app:cornerRadius="18dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/triage_active_abuse"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_size_triage_question"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/active_abuse_yes_button"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:backgroundTint="@color/surface"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/triage_yes"
                android:textAllCaps="false"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_triage_choice"
                app:cornerRadius="18dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/active_abuse_no_button"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/surface"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/triage_no"
                android:textAllCaps="false"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_triage_choice"
                app:cornerRadius="18dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/triage_injured_or_immobilized"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_size_triage_question"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/injured_or_immobilized_yes_button"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:backgroundTint="@color/surface"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/triage_yes"
                android:textAllCaps="false"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_triage_choice"
                app:cornerRadius="18dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/injured_or_immobilized_no_button"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/surface"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/triage_no"
                android:textAllCaps="false"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_triage_choice"
                app:cornerRadius="18dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/triage_street_situation"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_size_triage_question"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/street_situation_yes_button"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:backgroundTint="@color/surface"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/triage_yes"
                android:textAllCaps="false"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_triage_choice"
                app:cornerRadius="18dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/street_situation_no_button"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/surface"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/triage_no"
                android:textAllCaps="false"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_triage_choice"
                app:cornerRadius="18dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="@string/triage_classification_label"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_size_triage_classification_label" />

        <LinearLayout
            android:id="@+id/classification_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_triage_classification"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription=""
                android:src="@drawable/ic_warning"
                android:tint="@color/terracotta" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/classification_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_size_triage_classification_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/classification_response"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_size_triage_classification_response"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/classification_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_triage_description" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/triage_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:textColor="@color/terracotta_dark"
            android:textSize="@dimen/text_size_triage_error"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_report_button"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/terracotta"
            android:enabled="false"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/triage_confirm"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />
    </LinearLayout>
</ScrollView>
