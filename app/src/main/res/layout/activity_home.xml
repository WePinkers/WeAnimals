<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".home.presentation.HomeActivity">

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="76dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:text="@string/greeting"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="@string/home_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_screen_title"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_emergency_card"
                android:clipChildren="true"
                android:padding="16dp">

                <View
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-25dp"
                    android:layout_marginBottom="-25dp"
                    android:background="@drawable/bg_emergency_decor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/emergency_label"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_emergency_label"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="238dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="serif"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/emergency_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_emergency_title"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/report_now_button"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginTop="9dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="141dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/report_now"
                        android:textAllCaps="false"
                        android:textColor="@color/terracotta_dark"
                        android:textSize="@dimen/text_size_button"
                        android:textStyle="bold"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="22dp"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconPadding="7dp"
                        app:iconTint="@color/terracotta_dark" />
                </LinearLayout>
            </FrameLayout>

            <!-- "Perto de você" Header with "ver mapa" action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/near_you_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="@string/near_you"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_size_section_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/view_map_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    app:drawableEndCompat="@drawable/ic_chevron_right"
                    android:drawablePadding="4dp"
                    android:focusable="true"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:minHeight="40dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp"
                    android:text="@string/view_map"
                    android:textColor="@color/pine800"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/pine800" />
            </LinearLayout>

            <include
                android:id="@+id/map_preview"
                layout="@layout/map_preview"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/reports_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/reports"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_section_title"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/reports_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/reports_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_report_card"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp"
                android:text="@string/no_reports"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_report_body"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/main_navigation"
        layout="@layout/view_main_navigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom" />
</FrameLayout>
