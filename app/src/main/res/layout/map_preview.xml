<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:clickable="true"
    android:contentDescription="Mapa com ocorrências próximas"
    android:focusable="true"
    app:cardBackgroundColor="@color/map_background"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/line_border"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Real MapView Preview for Home -->
        <org.maplibre.android.maps.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay Pill Badge in Bottom Left -->
        <TextView
            android:id="@+id/map_chip"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_map_chip"
            android:elevation="4dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="10dp"
            android:text="@string/map_loading"
            android:textColor="@color/ink900"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Transparent Touch Overlay to navigate to MapActivity on tap -->
        <View
            android:id="@+id/map_click_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
