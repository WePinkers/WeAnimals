<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="20dp"
    tools:ignore="UnusedResources">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Assunto e descrição"
            android:textColor="#132A20"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subject Spinner / Dropdown -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="ASSUNTO"
            android:textColor="#5C5548"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_subject"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_stat_card"
            android:paddingHorizontal="12dp" />

        <!-- Description Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="DESCRIÇÃO"
            android:textColor="#5C5548"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_stat_card"
            android:gravity="top|start"
            android:hint="Descreva o ocorrido com o máximo de detalhes possível..."
            android:inputType="textMultiLine"
            android:maxLength="1000"
            android:minLines="4"
            android:padding="14dp"
            android:textColor="#132A20"
            android:textColorHint="#5C5548"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/char_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="0/1000"
            android:textColor="#5C5548"
            android:textSize="11sp" />

        <!-- Evidence Attachment (Optional) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="ANEXAR EVIDÊNCIAS (OPCIONAL)"
            android:textColor="#5C5548"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/container_attach_file"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dashed_upload"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_document"
                app:tint="#2C5240" />

            <TextView
                android:id="@+id/txt_attached_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Adicionar arquivos"
                android:textColor="#132A20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Footer Button -->
        <Button
            android:id="@+id/btn_next_step2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#1F3D2E"
            android:text="Próximo"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
