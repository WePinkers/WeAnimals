<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".community.feed.presentation.CommunityActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="@string/community_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_screen_title"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/search_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_community_search"
                android:contentDescription="@string/community_search"
                android:padding="9dp"
                android:src="@drawable/ic_search"
                app:tint="@color/pine800" />

            <TextView
                android:id="@+id/create_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_community_search"
                android:contentDescription="@string/community_create"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/pine800"
                android:textSize="20sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/search_field_container"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_location_search_field"
            android:visibility="gone">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/community_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="48dp"
                android:singleLine="true"
                android:textColor="@color/ink900"
                android:textColorHint="@color/muted"
                android:textSize="@dimen/text_size_location_search_input" />

            <ImageButton
                android:id="@+id/clear_search_button"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_search"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                android:tint="@color/muted"
                android:visibility="gone" />
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filter_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="0dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:checked="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/community_filter_all"
                    android:textSize="@dimen/text_size_report_chip"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="10dp"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="10dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_campaigns"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/community_filter_campaigns"
                    android:textSize="@dimen/text_size_report_chip"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="10dp"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="10dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_posts"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/community_filter_posts"
                    android:textSize="@dimen/text_size_report_chip"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="10dp"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="10dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_found"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/community_filter_found"
                    android:textSize="@dimen/text_size_report_chip"
                    android:visibility="gone"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="10dp"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="10dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_neutering"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/community_filter_neutering"
                    android:textSize="@dimen/text_size_report_chip"
                    android:visibility="gone"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="10dp"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="10dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_vaccination"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/community_filter_vaccination"
                    android:textSize="@dimen/text_size_report_chip"
                    android:visibility="gone"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="10dp"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="10dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_neighborhood"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/community_filter_neighborhood"
                    android:textSize="@dimen/text_size_report_chip"
                    android:visibility="gone"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="10dp"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="10dp"
                    app:ensureMinTouchTargetSize="false" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/context_filter_container"
            android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="@string/community_filter_context_label"
                android:textColor="@color/pine800"
                android:textSize="9sp" />

            <FrameLayout
                android:id="@+id/context_filter_layout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_community_filter_field">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/context_filter_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:dropDownSelector="@drawable/bg_community_filter_option"
                    android:drawableEnd="@drawable/ic_filter_chevron_down"
                    android:drawableTint="@color/pine800"
                    android:gravity="center_vertical"
                    android:includeFontPadding="true"
                    android:inputType="none"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/ink900"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:completionThreshold="0" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="360dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/feed_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="20dp"
                android:paddingTop="2dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/feed_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="360dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:paddingBottom="32dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_community"
                    app:tint="@color/border" />

                <TextView
                    android:id="@+id/state_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/community_empty_title"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_size_report_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/state_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/community_empty_message"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_report_body" />

            </LinearLayout>
        </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include android:id="@+id/main_navigation" layout="@layout/view_main_navigation" />
</LinearLayout>
