<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical">
    <include android:id="@+id/screen_header" layout="@layout/view_screen_header" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/favorites_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:padding="20dp" />
        <TextView android:id="@+id/empty_state" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center"
            android:padding="32dp" android:text="@string/profile_favorites_loading"
            android:textAlignment="center" android:textColor="@color/muted"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
