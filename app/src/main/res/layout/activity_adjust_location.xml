<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:ignore="UnusedResources">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circular_back_btn"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="serif"
            android:text="Onde encontrou o animal?"
            android:textColor="@color/pine800"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Form Scrollable -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Option 1: Usar minha localização atual -->
            <LinearLayout
                android:id="@+id/btn_use_current_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white_border"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/terracotta" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usar minha localização atual"
                        android:textColor="@color/terracotta"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Preenche o endereço usando o GPS do dispositivo"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_location_loading"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Option 2 Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="INFORMAR ENDEREÇO MANUAMENTE"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Field: Rua ou avenida -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Rua ou avenida *"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_street"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_white_border"
                android:hint="Ex: Rua Curuçá"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ink"
                android:textColorHint="#9C968A"
                android:textSize="14sp" />

            <!-- Field: Número -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Número"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_number"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_white_border"
                android:hint="Ex: 120 ou Sem número"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ink"
                android:textColorHint="#9C968A"
                android:textSize="14sp" />

            <!-- Field: Bairro -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bairro *"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_neighborhood"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_white_border"
                android:hint="Ex: Vila Maria"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ink"
                android:textColorHint="#9C968A"
                android:textSize="14sp" />

            <!-- Row: Cidade and Estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1.8"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cidade *"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_city"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_card_white_border"
                        android:hint="Ex: São Paulo"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/ink"
                        android:textColorHint="#9C968A"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado (UF) *"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/sp_state"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_card_white_border"
                        android:paddingHorizontal="8dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Field: Complemento / Ponto de referência -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Complemento ou ponto de referência"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_complement"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_white_border"
                android:hint="Ex: Próximo à praça"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ink"
                android:textColorHint="#9C968A"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer Confirm Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_confirm_location"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="16dp"
            android:background="@drawable/bg_btn_terracotta"
            android:text="Confirmar localização"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
