<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".adoption.listing.presentation.AdoptionActivity">

    <LinearLayout
        android:id="@+id/screen_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/adoption_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="@string/adoption_eyebrow"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_eyebrow" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="@string/adoption_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_screen_title"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filter_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="0dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:checkable="true"
                android:fontFamily="sans-serif"
                android:text="@string/adoption_filter_all"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_report_chip"
                android:textStyle="bold"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="32dp"
                app:chipStrokeColor="@color/border"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_dogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:fontFamily="sans-serif"
                android:text="@string/adoption_filter_dogs"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_report_chip"
                android:textStyle="bold"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="32dp"
                app:chipStrokeColor="@color/border"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_cats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:fontFamily="sans-serif"
                android:text="@string/adoption_filter_cats"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_report_chip"
                android:textStyle="bold"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="32dp"
                app:chipStrokeColor="@color/border"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_nearest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:fontFamily="sans-serif"
                android:text="@string/adoption_filter_nearest"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_report_chip"
                android:textStyle="bold"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="32dp"
                app:chipStrokeColor="@color/border"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />
        </com.google.android.material.chip.ChipGroup>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/animals_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_animal" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingBottom="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/state_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_adoption_heart"
                app:tint="@color/border" />

            <TextView
                android:id="@+id/state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/adoption_empty_all"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_report_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/state_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:text="@string/adoption_empty_description"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_report_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/state_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:minHeight="48dp"
                android:text="@string/adoption_retry"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/adoption_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/loading_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/adoption_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/adoption_loading"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_report_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/page_loading"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/adoption_loading_more"
                android:indeterminateTint="@color/adoption_primary" />

            <TextView
                android:id="@+id/page_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/adoption_error_more"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_report_body"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/page_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:minHeight="48dp"
                android:text="@string/adoption_retry"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/adoption_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>

    <include android:id="@+id/main_navigation" layout="@layout/view_main_navigation" />
</LinearLayout>
