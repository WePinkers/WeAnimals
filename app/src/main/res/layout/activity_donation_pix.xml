<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".community.campaign.presentation.DonationPixActivity">

    <include
        android:id="@+id/pix_header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:id="@+id/pix_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_pix_choose_amount"
                android:textColor="@color/clay600"
                android:textSize="@dimen/text_size_report_label" />

            <LinearLayout
                android:id="@+id/pix_amount_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/pix_amount_5"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:minWidth="0dp"
                        android:text="R$ 5"
                        android:textSize="@dimen/text_size_report_chip"
                        app:checkedIconVisible="false"
                        app:chipCornerRadius="12dp"
                        app:chipEndPadding="0dp"
                        app:chipMinHeight="36dp"
                        app:chipStartPadding="0dp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/pix_amount_10"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:minWidth="0dp"
                        android:text="R$ 10"
                        android:textSize="@dimen/text_size_report_chip"
                        app:checkedIconVisible="false"
                        app:chipCornerRadius="12dp"
                        app:chipEndPadding="0dp"
                        app:chipMinHeight="36dp"
                        app:chipStartPadding="0dp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/pix_amount_20"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:minWidth="0dp"
                        android:text="R$ 20"
                        android:textSize="@dimen/text_size_report_chip"
                        app:checkedIconVisible="false"
                        app:chipCornerRadius="12dp"
                        app:chipEndPadding="0dp"
                        app:chipMinHeight="36dp"
                        app:chipStartPadding="0dp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/pix_amount_50"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:minWidth="0dp"
                        android:text="R$ 50"
                        android:textSize="@dimen/text_size_report_chip"
                        app:checkedIconVisible="false"
                        app:chipCornerRadius="12dp"
                        app:chipEndPadding="0dp"
                        app:chipMinHeight="36dp"
                        app:chipStartPadding="0dp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/pix_amount_100"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:minWidth="0dp"
                        android:text="R$ 100"
                        android:textSize="@dimen/text_size_report_chip"
                        app:checkedIconVisible="false"
                        app:chipCornerRadius="12dp"
                        app:chipEndPadding="0dp"
                        app:chipMinHeight="36dp"
                        app:chipStartPadding="0dp"
                        app:ensureMinTouchTargetSize="false" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/pix_amount_other"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:checkable="true"
                    android:text="@string/community_pix_other"
                    android:textSize="@dimen/text_size_report_chip"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="12dp"
                    app:chipMinHeight="36dp"
                    app:ensureMinTouchTargetSize="false" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="162dp"
                android:layout_height="162dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_report_card"
                android:padding="24dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/community_pix_qr_description"
                    android:src="@drawable/ic_pix_qr" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/community_pix_key_label"
                android:textColor="@color/clay600"
                android:textSize="@dimen/text_size_report_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_campaign_info"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingTop="11dp"
                android:paddingEnd="7dp"
                android:paddingBottom="11dp">

                <TextView
                    android:id="@+id/pix_key_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:textColor="@color/ink600"
                    android:textSize="@dimen/text_size_details_body"
                    tools:text="doacoes@patasunidas.org.br" />

                <ImageButton
                    android:id="@+id/copy_pix_button"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_report_card"
                    android:contentDescription="@string/community_pix_copy"
                    android:padding="8dp"
                    android:src="@drawable/ic_copy" />
            </LinearLayout>

            <TextView
                android:id="@+id/pix_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campaign_info"
                android:padding="12dp"
                android:text="@string/community_pix_note"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_details_body" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pix_done_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/community_pix_done"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_button"
        android:textStyle="bold"
        app:backgroundTint="@color/clay600"
        app:cornerRadius="14dp" />
</LinearLayout>
