<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".adoption.questionnaire.presentation.AdoptionQuestionnaireActivity">

    <include
        android:id="@+id/questionnaire_header"
        layout="@layout/view_screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/questionnaire_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:lineSpacingExtra="2dp"
                android:text="@string/adoption_questionnaire_intro"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_adoption_questionnaire_intro" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/adoption_question_routine"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_adoption_questionnaire_question"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/routine_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/routine_away"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_routine_away"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/routine_home_office"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_routine_home_office"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/routine_home_often"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_routine_home_often"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/adoption_question_space"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_adoption_questionnaire_question"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/space_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/space_small_apartment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_space_small_apartment"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/space_balcony"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_space_balcony"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/space_yard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_space_yard"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/adoption_question_experience"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_adoption_questionnaire_question"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/experience_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/experience_first"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_experience_first"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/experience_had_pets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_experience_had_pets"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/experience_has_pets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_experience_has_pets"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/adoption_question_daily_time"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_adoption_questionnaire_question"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/daily_time_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/daily_time_less_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_daily_time_less_one"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/daily_time_one_three"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_daily_time_one_three"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/daily_time_more_three"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_daily_time_more_three"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/adoption_question_household"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_adoption_questionnaire_question"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/household_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/household_alone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_household_alone"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/household_children"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_household_children"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/household_pets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/adoption_household_pets"
                    android:textSize="@dimen/text_size_adoption_questionnaire_option"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/questionnaire_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:textColor="@color/terracotta_dark"
            android:textSize="@dimen/text_size_adoption_questionnaire_error"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="@color/terracotta"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/adoption_questionnaire_submit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
