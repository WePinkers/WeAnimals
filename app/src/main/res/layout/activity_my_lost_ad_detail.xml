<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:ignore="UnusedResources">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Bleeding Header Cover Banner -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@drawable/bg_ad_cover_gradient">

            <!-- Paw Icon when no photo is available -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:alpha="0.55"
                android:contentDescription="@null"
                android:src="@drawable/ic_paw"
                app:tint="#BE6D46" />

            <!-- Real photo preview -->
            <ImageView
                android:id="@+id/ad_photo_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto do animal"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Floating Back Button -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_circular_white_button"
                android:contentDescription="Voltar"
                android:elevation="2dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#132A20" />

            <!-- Floating Status Badge (Pill) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_status_lost_pill"
                android:elevation="2dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Ativo"
                android:textColor="#A83232"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 2. Ad Body Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Title & Subtitle -->
            <TextView
                android:id="@+id/ad_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Pipoca, desaparecido há 4 dias"
                android:textColor="#132A20"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ad_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vila Marlene · publicado em 24/08/2026"
                android:textColor="#5C5548"
                android:textSize="11sp" />

            <!-- Tags / Chips Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_soft_sand"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Cão"
                    android:textColor="#1F3D2E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_soft_sand"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Porte médio"
                    android:textColor="#1F3D2E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_soft_sand"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Adulto"
                    android:textColor="#1F3D2E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_soft_sand"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="SRD"
                    android:textColor="#1F3D2E"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Featured Matches Card -->
            <LinearLayout
                android:id="@+id/card_matches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_matches_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="3 possíveis matches"
                    android:textColor="#1F3D2E"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="O melhor tem 91% de compatibilidade."
                    android:textColor="#5C5548"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_view_matches"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#1F3D2E"
                    android:text="VER MATCHES"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- 4. Secondary Actions Bar (Single-line Buttons) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_share"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/white"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:paddingHorizontal="2dp"
                    android:singleLine="true"
                    android:text="Compartilhar"
                    android:textColor="#1F3D2E"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_share"
                    app:iconPadding="4dp"
                    app:iconSize="14dp"
                    app:iconTint="#1F3D2E"
                    app:strokeColor="#DDD6C4" />

                <Button
                    android:id="@+id/btn_copy_link"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/white"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:paddingHorizontal="2dp"
                    android:singleLine="true"
                    android:text="Copiar link"
                    android:textColor="#1F3D2E"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_copy"
                    app:iconPadding="4dp"
                    app:iconSize="14dp"
                    app:iconTint="#1F3D2E"
                    app:strokeColor="#DDD6C4" />

                <Button
                    android:id="@+id/btn_poster"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/white"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:paddingHorizontal="2dp"
                    android:singleLine="true"
                    android:text="Cartaz"
                    android:textColor="#1F3D2E"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_document"
                    app:iconPadding="4dp"
                    app:iconSize="14dp"
                    app:iconTint="#1F3D2E"
                    app:strokeColor="#DDD6C4" />
            </LinearLayout>

            <!-- 5. Management Rows -->
            <LinearLayout
                android:id="@+id/btn_edit_ad"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_edit"
                    app:tint="#1F3D2E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Editar anúncio"
                    android:textColor="#132A20"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#5C5548" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border" />

            <LinearLayout
                android:id="@+id/btn_close_ad"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_close"
                    app:tint="#5C5548" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Encerrar anúncio"
                    android:textColor="#5C5548"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#5C5548" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
