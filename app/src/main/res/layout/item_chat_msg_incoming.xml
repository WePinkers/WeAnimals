<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_msg_incoming"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/msg_incoming_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olá! Vi que você registrou que encontrou o Pipoca."
            android:textColor="#132A20"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/msg_incoming_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:text="14:32"
            android:textColor="#5C5548"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
