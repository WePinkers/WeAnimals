<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".adoption.detail.presentation.AnimalDetailsActivity">

    <LinearLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/details_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/adoption_detail_gallery_height"
            android:background="@drawable/bg_adoption_photo">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/photo_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never" />

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_adoption_detail_action"
                android:contentDescription="@string/back"
                android:padding="7dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ink" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/share_button"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_adoption_detail_action"
                    android:contentDescription="@string/adoption_detail_share"
                    android:padding="9dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/muted" />

                <ImageButton
                    android:id="@+id/favorite_button"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_adoption_detail_action"
                    android:contentDescription="@string/adoption_detail_add_favorite"
                    android:padding="9dp"
                    android:src="@drawable/ic_favorite_outline"
                    app:tint="@color/muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/photo_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />
        </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/animal_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="serif"
                        android:includeFontPadding="false"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_adoption_detail_name"
                        android:textStyle="bold"
                        tools:text="Canela" />

                    <TextView
                        android:id="@+id/distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_adoption_detail_distance"
                        tools:text="1,4km" />
                </LinearLayout>

                <TextView
                    android:id="@+id/waiting_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawablePadding="5dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textColor="@color/terracotta"
                    android:textSize="@dimen/text_size_adoption_detail_waiting"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_clock"
                    app:drawableTint="@color/terracotta"
                    tools:text="Aguardando um lar há 3 meses" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/breed_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_adoption_detail_chip"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_adoption_detail_chip"
                        android:textStyle="bold"
                        tools:text="SRD" />

                    <TextView
                        android:id="@+id/age_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_adoption_detail_chip"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_adoption_detail_chip"
                        android:textStyle="bold"
                        tools:text="2 anos" />

                    <TextView
                        android:id="@+id/size_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_adoption_detail_chip"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_adoption_detail_chip"
                        android:textStyle="bold"
                        tools:text="Porte médio" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/vaccinated_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_adoption_detail_chip"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/adoption_detail_vaccinated"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_adoption_detail_chip"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/neutered_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_adoption_detail_chip"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/adoption_detail_neutered"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_size_adoption_detail_chip"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="@string/adoption_detail_compatibility"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_adoption_detail_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="94dp"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/children_card"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_adoption_detail_compatibility"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_community"
                            app:tint="@color/terracotta" />

                        <TextView
                            android:id="@+id/children_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_size_adoption_detail_compatibility" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/animals_card"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_adoption_detail_compatibility"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_adoption_heart"
                            app:tint="@color/terracotta" />

                        <TextView
                            android:id="@+id/animals_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_size_adoption_detail_compatibility" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/energy_card"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_adoption_detail_compatibility"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_energy"
                            app:tint="@color/terracotta" />

                        <TextView
                            android:id="@+id/energy_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_size_adoption_detail_compatibility" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/about_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_adoption_detail_label"
                    tools:text="SOBRE A CANELA" />

                <TextView
                    android:id="@+id/about_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_adoption_detail_body"
                    tools:text="Resgatada em janeiro, dócil com crianças e outros cães. Castrada, vacinada e vermifugada." />

                <TextView
                    android:id="@+id/requirements_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="@string/adoption_detail_requirements"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_size_adoption_detail_label" />

                <LinearLayout
                    android:id="@+id/requirements_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/shelter_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="@string/adoption_detail_shelter"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_size_adoption_detail_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_adoption_detail_compatibility"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_adoption_detail_shelter_icon"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_shelter"
                            app:tint="@color/terracotta" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/shelter_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_size_adoption_detail_shelter_name"
                                android:textStyle="bold"
                                tools:text="Abrigo Esperança" />

                            <TextView
                                android:id="@+id/shelter_address"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:textColor="@color/muted"
                                android:textSize="@dimen/text_size_adoption_detail_shelter_address"
                                tools:text="Vila Marlene · a 2,3 km de você" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/conversation_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/adoption_detail_conversation"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"
                app:backgroundTint="@color/surface"
                app:cornerRadius="12dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/adopt_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/adoption_detail_adopt"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"
                app:backgroundTint="@color/terracotta"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/state_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:id="@+id/state_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/adoption_primary" />

        <TextView
            android:id="@+id/state_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/adoption_detail_loading"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_size_adoption_detail_state"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/state_action"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/adoption_retry"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/adoption_primary"
            app:cornerRadius="12dp" />
    </LinearLayout>
</FrameLayout>
