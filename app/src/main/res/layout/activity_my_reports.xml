<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical">
    <include android:id="@+id/screen_header" layout="@layout/view_screen_header" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/reports_summary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/profile_reports_loading"
                android:textColor="@color/muted" android:textSize="14sp" />
            <LinearLayout android:id="@+id/reports_container" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
