<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".organization.accreditation.presentation.OrganizationAccreditationActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

    <include
        android:id="@+id/accreditation_header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/accreditation_cnpj_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/accreditation_cnpj_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <EditText
                android:id="@+id/accreditation_cnpj_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_entry_input"
                android:hint="@string/accreditation_cnpj_hint"
                android:inputType="number"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink600"
                android:textSize="@dimen/text_size_report_body" />

            <TextView
                android:id="@+id/accreditation_legal_name_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/accreditation_legal_name_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <EditText
                android:id="@+id/accreditation_legal_name_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_entry_input"
                android:hint="@string/accreditation_legal_name_hint"
                android:inputType="textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink600"
                android:textSize="@dimen/text_size_report_body" />

            <TextView
                android:id="@+id/accreditation_email_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/accreditation_email_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <EditText
                android:id="@+id/accreditation_email_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_entry_input"
                android:hint="@string/accreditation_email_hint"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink600"
                android:textSize="@dimen/text_size_report_body" />

            <TextView
                android:id="@+id/accreditation_password_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/accreditation_password_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/accreditation_password_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_entry_input"
                    android:hint="@string/accreditation_password_hint"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="48dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink600"
                    android:textSize="@dimen/text_size_report_body" />

                <ImageButton
                    android:id="@+id/accreditation_password_toggle_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/login_show_password"
                    android:padding="12dp"
                    android:src="@drawable/ic_visibility_off" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="1dp"
                android:text="@string/accreditation_password_helper"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <TextView
                android:id="@+id/accreditation_document_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/accreditation_document_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <LinearLayout
                android:id="@+id/accreditation_document_dropzone"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_entry_upload"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_document" />

                <TextView
                    android:id="@+id/accreditation_document_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/accreditation_document_attach"
                    android:textColor="@color/ink"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/accreditation_pix_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/accreditation_pix_label"
                android:textColor="@color/ink600"
                android:textSize="@dimen/text_size_report_label" />

            <EditText
                android:id="@+id/accreditation_pix_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_entry_input"
                android:hint="@string/accreditation_pix_hint"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink600"
                android:textSize="@dimen/text_size_report_body" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/accreditation_legal_acceptance_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_legal_acceptance"
                android:button="@drawable/checkbox_donation_selector"
                android:drawablePadding="0dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/legal_acceptance_checkbox"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_details_body" />

            <TextView
                android:id="@+id/accreditation_legal_acceptance_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:text="@string/legal_acceptance_required_short"
                android:textColor="@color/alert600"
                android:textSize="@dimen/text_size_details_body"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/accreditation_submit_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/accreditation_submit"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pine800"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/accreditation_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_loading_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.example.weanimals.entry.presentation.SilhouetteLoadingView
                android:id="@+id/accreditation_loading_silhouette"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:contentDescription="@string/login_loading_description" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/accreditation_submitting"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
