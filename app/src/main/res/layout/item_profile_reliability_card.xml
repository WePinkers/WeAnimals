<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Title Row: Shield Check Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_shield_check"
            app:tint="@color/pine800" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="serif"
            android:text="Nível de Confiabilidade"
            android:textColor="@color/pine800"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Description Row -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Perfil verificado com histórico positivo de denúncias e ajuda comunitária."
        android:textColor="@color/muted"
        android:textSize="13sp" />

</LinearLayout>
