<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".reporting.chat.presentation.CaseChatActivity">

    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_back_button"
            android:contentDescription="@string/back"
            android:gravity="center"
            android:padding="0dp"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/ink" />

        <TextView
            android:id="@+id/chat_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_chat_avatar"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/chat_unassigned_avatar"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_chat_avatar"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_agent_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/chat_unassigned_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_chat_agent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_size_chat_protocol"
                tools:text="PROTOCOLO #4468" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <FrameLayout
        android:id="@+id/chat_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/messages_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/messages_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/chat_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_size_chat_state"
            android:visibility="gone"
            tools:text="@string/chat_unassigned_message"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/chat_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/chat_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:textColor="@color/red"
            android:textSize="@dimen/text_size_chat_error"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/message_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:hint="@string/chat_message_hint"
                android:includeFontPadding="false"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="1000"
                android:maxLines="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="@dimen/text_size_chat_input" />

            <ImageButton
                android:id="@+id/send_button"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:padding="0dp"
                android:background="@drawable/bg_chat_send"
                android:contentDescription="@string/chat_send"
                android:gravity="center"
                android:scaleType="center"
                android:src="@drawable/ic_send"
                android:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
