<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:ignore="UnusedResources">

    <include
        android:id="@+id/screen_header"
        layout="@layout/view_screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="86dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Green Banner Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_matches_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_paw"
                    app:tint="@color/pine800" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Pipoca voltou para casa!"
                        android:textColor="@color/pine800"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Procurado durante 4 dias · 3 matches gerados"
                        android:textColor="@color/ink600"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Question: How was he found? -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="COMO ELE FOI REENCONTRADO?"
                android:textColor="@color/ink600"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected_pine"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Match no app WeAnimals"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Compartilhamento em redes sociais"
                    android:textColor="@color/pine900"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Encontrou sozinho / Voltou só"
                    android:textColor="@color/pine900"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Optional Message -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="MENSAGEM DE AGRADECIMENTO (OPCIONAL)"
                android:textColor="@color/ink600"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_thanks_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_stat_card"
                android:gravity="top|start"
                android:hint="Ex.: Obrigado a todos que ajudaram a divulgar!"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="@color/pine900"
                android:textColorHint="@color/ink600"
                android:textSize="13.5sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <Button
            android:id="@+id/btn_close_and_register"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/clay600"
            android:text="Encerrar e registrar reencontro"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
