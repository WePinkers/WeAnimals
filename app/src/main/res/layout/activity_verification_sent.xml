<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="20dp"
    tools:ignore="UnusedResources">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Top Amber Clock Status Icon -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_amber_clock">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_clock"
                app:tint="#7A5710" />
        </FrameLayout>

        <!-- Title & Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            android:text="Respostas enviadas"
            android:textColor="#132A20"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="quem encontrou vai comparar com o que ela observou. Você recebe um aviso assim que o chat for liberado."
            android:textColor="#5C5548"
            android:textSize="13.5sp" />

        <!-- Horizontal Step Flowbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_flowbar_active"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="Respostas enviadas"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:text="›"
                android:textColor="#5C5548"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_flowbar_inactive"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="Em análise"
                android:textColor="#132A20"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:text="›"
                android:textColor="#5C5548"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_flowbar_inactive"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="Chat liberado"
                android:textColor="#132A20"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_stat_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="SUAS RESPOSTAS"
                android:textColor="#5C5548"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_summary_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="✓  Nome: Pipoca"
                android:textColor="#132A20"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_summary_mark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="✓  Marca: mancha em formato de coração"
                android:textColor="#132A20"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Footer Button -->
        <Button
            android:id="@+id/btn_back_to_ads"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#1C1A16"
            android:text="Voltar aos meus anúncios"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tempo médio de resposta: algumas horas"
            android:textColor="#5C5548"
            android:textSize="11.5sp" />

        <!-- Shortcut Button to Test Screen 11 (Finder View) -->
        <Button
            android:id="@+id/btn_test_review_screen"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="Ver visão de quem encontrou"
            android:textColor="#1F3D2E"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/border" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
