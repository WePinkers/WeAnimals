rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsReport(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    function ownsReportById(reportId) {
      return signedIn()
        && exists(/databases/$(database)/documents/reports/$(reportId))
        && ownsReport(get(/databases/$(database)/documents/reports/$(reportId)).data);
    }

    function isTeamMember() {
      return signedIn() && request.auth.token.teamMember == true;
    }

    match /reports/{reportId} {
      allow create: if ownsReport(request.resource.data)
        && request.resource.data.protocolNumber is int
        && request.resource.data.status == 'new';

      allow read: if ownsReport(resource.data);

      allow update: if ownsReport(resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.protocolNumber == resource.data.protocolNumber;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if ownsReportById(reportId) || isTeamMember();

        allow create: if (
          ownsReportById(reportId)
          && request.resource.data.reportId == reportId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == 'user'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
        ) || (
          isTeamMember()
          && request.resource.data.reportId == reportId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == 'team'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
        );

        allow update, delete: if false;
      }
    }

    // Public adoption cards contain only shelter/animal information.
    // NGO management and its write permissions belong to the future staff flow.
    match /animais/{animalId} {
      allow read: if signedIn() && resource.data.status == 'disponivel';
      allow write: if false;
    }

    // A public point contains only an animal category, urgency and a 0.01° grid cell.
    // It is created atomically with its private report; exact coordinates never leave reports.
    function matchesPrivateReport(reportId) {
      let report = getAfter(/databases/$(database)/documents/reports/$(reportId)).data;
      let publicData = request.resource.data;
      return report.userId == request.auth.uid
        && report.status == 'new'
        && report.animalType == publicData.animalType
        && report.urgency == publicData.urgency
        && report.latitude is number
        && report.longitude is number
        && report.latitude >= publicData.latitudeCell / 100.0
        && report.latitude < (publicData.latitudeCell + 1) / 100.0
        && report.longitude >= publicData.longitudeCell / 100.0
        && report.longitude < (publicData.longitudeCell + 1) / 100.0;
    }

    match /public_occurrences/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && existsAfter(/databases/$(database)/documents/reports/$(reportId))
        && request.resource.data.keys().hasOnly([
          'animalType', 'urgency', 'latitudeCell', 'longitudeCell', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'animalType', 'urgency', 'latitudeCell', 'longitudeCell', 'createdAt'
        ])
        && request.resource.data.animalType in ['dog', 'cat', 'other']
        && request.resource.data.urgency in ['low', 'medium', 'high']
        && request.resource.data.latitudeCell is int
        && request.resource.data.latitudeCell >= -9000
        && request.resource.data.latitudeCell < 9000
        && request.resource.data.longitudeCell is int
        && request.resource.data.longitudeCell >= -18000
        && request.resource.data.longitudeCell < 18000
        && request.resource.data.createdAt == request.time
        && matchesPrivateReport(reportId);
      allow update, delete: if false;
    }

    match /user_favorites/{userId}/animals/{animalId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && exists(/databases/$(database)/documents/animais/$(animalId))
        && get(/databases/$(database)/documents/animais/$(animalId)).data.status == 'disponivel'
        && request.resource.data.keys().hasOnly(['animalId', 'createdAt'])
        && request.resource.data.keys().hasAll(['animalId', 'createdAt'])
        && request.resource.data.animalId == animalId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // Public campaigns are created by verified NGO/organization accounts.
    // Their event details are public because they are intended for participation.
    match /community_campaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && isTeamMember()
        && request.resource.data.keys().hasAll([
          'organizationId', 'organizationName', 'createdBy', 'category',
          'title', 'dateText', 'locationText', 'locationLabel',
          'availabilityText', 'audienceText', 'description', 'highlightText',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'organizationId', 'organizationName', 'createdBy', 'category',
          'title', 'dateText', 'locationText', 'locationLabel',
          'availabilityText', 'audienceText', 'description', 'highlightText',
          'createdAt', 'totalSlots', 'filledSlots', 'donationGoalCents',
          'donationRaisedCents', 'donationNeeds', 'pixKey',
          'locationLatitude', 'locationLongitude'
        ])
        && request.resource.data.organizationId == request.auth.token.ngoId
        && request.resource.data.organizationName is string
        && request.resource.data.organizationName.size() > 0
        && request.resource.data.organizationName.size() <= 100
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.category in [
          'NEUTERING', 'VACCINATION', 'ADOPTION', 'DONATION'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.dateText is string
        && request.resource.data.dateText.size() > 0
        && request.resource.data.dateText.size() <= 120
        && request.resource.data.locationText is string
        && request.resource.data.locationText.size() > 0
        && request.resource.data.locationText.size() <= 160
        && request.resource.data.locationLabel is string
        && request.resource.data.locationLabel.size() > 0
        && request.resource.data.locationLabel.size() <= 100
        && request.resource.data.availabilityText is string
        && request.resource.data.availabilityText.size() <= 120
        && request.resource.data.audienceText is string
        && request.resource.data.audienceText.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1200
        && request.resource.data.highlightText is string
        && request.resource.data.highlightText.size() <= 240
        && (!request.resource.data.keys().hasAny(['totalSlots'])
          || (request.resource.data.totalSlots is int
            && request.resource.data.totalSlots > 0
            && request.resource.data.totalSlots <= 100000))
        && (!request.resource.data.keys().hasAny(['filledSlots'])
          || (request.resource.data.filledSlots is int
            && request.resource.data.filledSlots >= 0
            && (!request.resource.data.keys().hasAny(['totalSlots'])
              || request.resource.data.filledSlots <= request.resource.data.totalSlots)))
        && (!request.resource.data.keys().hasAny(['donationGoalCents'])
          || (request.resource.data.donationGoalCents is int
            && request.resource.data.donationGoalCents > 0
            && request.resource.data.donationGoalCents <= 10000000000))
        && (!request.resource.data.keys().hasAny(['donationRaisedCents'])
          || (request.resource.data.donationRaisedCents is int
            && request.resource.data.donationRaisedCents >= 0
            && (!request.resource.data.keys().hasAny(['donationGoalCents'])
              || request.resource.data.donationRaisedCents <= request.resource.data.donationGoalCents)))
        && (!request.resource.data.keys().hasAny(['donationNeeds'])
          || (request.resource.data.donationNeeds is list
            && request.resource.data.donationNeeds.size() <= 20))
        && (!request.resource.data.keys().hasAny(['pixKey'])
          || (request.resource.data.pixKey is string
            && request.resource.data.pixKey.size() <= 200))
        && (!request.resource.data.keys().hasAny(['locationLatitude'])
          || (request.resource.data.locationLatitude is number
            && request.resource.data.locationLatitude >= -90
            && request.resource.data.locationLatitude <= 90))
        && (!request.resource.data.keys().hasAny(['locationLongitude'])
          || (request.resource.data.locationLongitude is number
            && request.resource.data.locationLongitude >= -180
            && request.resource.data.locationLongitude <= 180))
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['filledSlots'])
        && resource.data.category == 'NEUTERING'
        && request.resource.data.filledSlots is int
        && request.resource.data.filledSlots == resource.data.get('filledSlots', 0) + 1
        && (!resource.data.keys().hasAny(['totalSlots'])
          || request.resource.data.filledSlots <= resource.data.totalSlots);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['donationRaisedCents'])
        && resource.data.category == 'DONATION'
        && request.resource.data.donationRaisedCents is int
        && request.resource.data.donationRaisedCents > resource.data.get('donationRaisedCents', 0)
        && (!resource.data.keys().hasAny(['donationGoalCents'])
          || request.resource.data.donationRaisedCents <= resource.data.donationGoalCents);
      allow delete: if false;
    }

    match /community_campaigns/{campaignId}/animals/{animalId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && isTeamMember()
        && existsAfter(/databases/$(database)/documents/community_campaigns/$(campaignId))
        && getAfter(/databases/$(database)/documents/community_campaigns/$(campaignId)).data.organizationId
          == request.auth.token.ngoId
        && getAfter(/databases/$(database)/documents/community_campaigns/$(campaignId)).data.category == 'ADOPTION'
        && request.resource.data.keys().hasAll([
          'name', 'breed', 'ageText', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'breed', 'ageText', 'photoData', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.breed is string
        && request.resource.data.breed.size() <= 80
        && request.resource.data.ageText is string
        && request.resource.data.ageText.size() <= 80
        && (!request.resource.data.keys().hasAny(['photoData'])
          || (request.resource.data.photoData is bytes
            && request.resource.data.photoData.size() <= 200000))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /community_campaigns/{campaignId}/participants/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && existsAfter(/databases/$(database)/documents/community_campaigns/$(campaignId))
        && getAfter(/databases/$(database)/documents/community_campaigns/$(campaignId)).data.category in [
          'NEUTERING', 'VACCINATION', 'ADOPTION'
        ]
        && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /community_campaigns/{campaignId}/donations/{donationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && existsAfter(/databases/$(database)/documents/community_campaigns/$(campaignId))
        && getAfter(/databases/$(database)/documents/community_campaigns/$(campaignId)).data.category == 'DONATION'
        && request.resource.data.keys().hasOnly(['userId', 'amountCents', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 100
        && request.resource.data.amountCents <= 10000000000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /community_campaigns/{campaignId}/item_donations/{donationId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.userId || isTeamMember());
      allow create: if signedIn()
        && existsAfter(/databases/$(database)/documents/community_campaigns/$(campaignId))
        && getAfter(/databases/$(database)/documents/community_campaigns/$(campaignId)).data.category == 'DONATION'
        && request.resource.data.keys().hasOnly([
          'userId', 'items', 'otherItem', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 20
        && request.resource.data.otherItem is string
        && request.resource.data.otherItem.size() <= 160
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Public community posts reveal a broad region, never exact coordinates or street address.
    // Only authenticated users may create their own posts. Campaign writes remain blocked.
    match /community_posts/{postId} {
      allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasAll([
            'authorId', 'authorName', 'category', 'body', 'locationLabel', 'createdAt'
          ])
        && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'category', 'body', 'locationLabel', 'createdAt', 'photoData'
          ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.category in ['FOUND', 'QUESTION', 'NOTICE', 'OTHER']
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000
        && request.resource.data.locationLabel is string
        && request.resource.data.locationLabel.size() > 0
        && request.resource.data.locationLabel.size() <= 80
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['photoData'])
          || (request.resource.data.photoData is bytes
            && request.resource.data.photoData.size() <= 200000));
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likesCount', 'commentsCount'])
          && request.resource.data.likesCount is int
          && request.resource.data.commentsCount is int
          && request.resource.data.likesCount >= 0
          && request.resource.data.commentsCount >= 0
          && (
            request.resource.data.likesCount == resource.data.get('likesCount', 0)
            || request.resource.data.likesCount == resource.data.get('likesCount', 0) + 1
            || request.resource.data.likesCount == resource.data.get('likesCount', 0) - 1
          )
          && (
            request.resource.data.commentsCount == resource.data.get('commentsCount', 0)
            || request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1
          )
          && (
            request.resource.data.likesCount != resource.data.get('likesCount', 0)
            || request.resource.data.commentsCount != resource.data.get('commentsCount', 0)
          );
        allow delete: if false;

        match /comments/{commentId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && request.resource.data.keys().hasOnly([
              'authorId', 'authorName', 'text', 'createdAt', 'parentCommentId'
            ])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() > 0
            && request.resource.data.authorName.size() <= 100
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && (
              !request.resource.data.keys().hasAny(['parentCommentId'])
              || (
                request.resource.data.parentCommentId is string
                && request.resource.data.parentCommentId.size() > 0
                && request.resource.data.parentCommentId.size() <= 100
              )
            )
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /likes/{userId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && request.auth.uid == userId
            && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow delete: if signedIn() && request.auth.uid == userId;
          allow update: if false;
        }
      }

    match /adoption_profiles/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /adoption_applications/{userId}/animals/{animalId} {
      allow read: if (signedIn() && request.auth.uid == userId)
        || (isTeamMember() && request.auth.token.ngoId == resource.data.ngoId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/animais/$(animalId))
        && get(/databases/$(database)/documents/animais/$(animalId)).data.status == 'disponivel'
        && request.resource.data.keys().hasOnly([
          'userId', 'animalId', 'ngoId', 'status', 'matchPercentage',
          'profile', 'submittedAt', 'animalName', 'shelterName',
          'breed', 'ageText', 'photoUrl'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.animalId == animalId
        && request.resource.data.ngoId ==
          get(/databases/$(database)/documents/animais/$(animalId)).data.ong_id
        && request.resource.data.status == 'pending'
        && request.resource.data.matchPercentage is int
        && request.resource.data.matchPercentage >= 0
        && request.resource.data.matchPercentage <= 100
        && request.resource.data.profile is map
        && request.resource.data.animalName ==
          get(/databases/$(database)/documents/animais/$(animalId)).data.nome
        && request.resource.data.shelterName is string
        && request.resource.data.breed is string
        && request.resource.data.ageText is string
        && request.resource.data.photoUrl is string
        && request.resource.data.submittedAt == request.time;
      allow update: if signedIn()
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.status == 'adopted'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt', 'adoptedAt'])
            && request.resource.data.keys().hasAll(['adoptedAt'])
            && request.resource.data.adoptedAt is timestamp
            && request.resource.data.adoptedAt >= resource.data.submittedAt
            && request.resource.data.adoptedAt <= request.time)
          || (request.resource.data.status != 'adopted'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']))
        )
        && (
          (request.auth.uid == userId
            && resource.data.status in ['pending', 'reviewing']
            && request.resource.data.status == 'cancelled')
          || (isTeamMember()
            && request.auth.token.ngoId == resource.data.ngoId
            && resource.data.status in ['pending', 'reviewing', 'approved', 'visit_scheduled']
            && request.resource.data.status in [
              'reviewing', 'approved', 'rejected', 'visit_scheduled', 'adopted'
            ])
          || (isTeamMember()
            && request.auth.token.ngoId == resource.data.ngoId
            && resource.data.status == 'adopted'
            && request.resource.data.status == 'adopted'
            && !resource.data.keys().hasAny(['adoptedAt']))
        );
      allow delete: if false;

      match /checkins/{milestoneId} {
        allow read: if (signedIn() && request.auth.uid == userId)
          || (isTeamMember()
            && exists(/databases/$(database)/documents/adoption_applications/$(userId)/animals/$(animalId))
            && request.auth.token.ngoId ==
              get(/databases/$(database)/documents/adoption_applications/$(userId)/animals/$(animalId)).data.ngoId);
        allow create: if signedIn()
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/adoption_applications/$(userId)/animals/$(animalId))
          && get(/databases/$(database)/documents/adoption_applications/$(userId)/animals/$(animalId)).data.status == 'adopted'
          && (milestoneId == '30'
            || (milestoneId == '90'
              && exists(/databases/$(database)/documents/adoption_applications/$(userId)/animals/$(animalId)/checkins/30))
            || (milestoneId == '180'
              && exists(/databases/$(database)/documents/adoption_applications/$(userId)/animals/$(animalId)/checkins/30)
              && exists(/databases/$(database)/documents/adoption_applications/$(userId)/animals/$(animalId)/checkins/90)))
          && request.resource.data.keys().hasAll([
            'milestoneDays', 'rating', 'answers', 'note', 'submittedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'milestoneDays', 'rating', 'answers', 'note', 'submittedAt'
          ])
          && ((milestoneId == '30' && request.resource.data.milestoneDays == 30)
            || (milestoneId == '90' && request.resource.data.milestoneDays == 90)
            || (milestoneId == '180' && request.resource.data.milestoneDays == 180))
          && request.resource.data.rating in [
            'difficult', 'some_challenges', 'good', 'excellent'
          ]
          && request.resource.data.answers is map
          && (
            (milestoneId == '30'
              && request.resource.data.answers.keys().hasAll([
                'routine_adjusted', 'health_or_behavior_issue'
              ])
              && request.resource.data.answers.keys().hasOnly([
                'routine_adjusted', 'health_or_behavior_issue'
              ])
              && request.resource.data.answers.routine_adjusted in ['yes', 'no', 'partly']
              && request.resource.data.answers.health_or_behavior_issue in ['yes', 'no'])
            || (milestoneId == '90'
              && request.resource.data.answers.keys().hasAll([
                'walks_and_feeding_established', 'behavior_changed', 'regular_vet_visits'
              ])
              && request.resource.data.answers.keys().hasOnly([
                'walks_and_feeding_established', 'behavior_changed', 'regular_vet_visits'
              ])
              && request.resource.data.answers.walks_and_feeding_established in ['yes', 'no', 'partly']
              && request.resource.data.answers.behavior_changed in ['yes', 'no']
              && request.resource.data.answers.regular_vet_visits in ['yes', 'no'])
            || (milestoneId == '180'
              && request.resource.data.answers.keys().hasAll([
                'strong_bond', 'shelter_support_needed', 'recommend_adoption'
              ])
              && request.resource.data.answers.keys().hasOnly([
                'strong_bond', 'shelter_support_needed', 'recommend_adoption'
              ])
              && request.resource.data.answers.strong_bond in ['yes', 'no', 'partly']
              && request.resource.data.answers.shelter_support_needed in ['yes', 'no']
              && request.resource.data.answers.recommend_adoption in ['yes_certainly', 'maybe'])
          )
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 1000
          && request.resource.data.submittedAt == request.time;
        allow update, delete: if false;
      }
    }

    // The animal detail and candidature tracking open the same adoption chat.
    // Only the adopter and members of the responsible NGO can access its messages.
    match /adoption_conversations/{userId}/animals/{animalId} {
      allow read: if (signedIn() && request.auth.uid == userId)
        || (isTeamMember() && request.auth.token.ngoId == resource.data.ngoId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'userId', 'animalId', 'ngoId', 'createdAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.animalId == animalId
        && request.resource.data.ngoId is string
        && request.resource.data.ngoId.size() > 0
        && request.resource.data.createdAt == request.time
        && (
          (exists(/databases/$(database)/documents/adoption_applications/$(userId)/animals/$(animalId))
            && request.resource.data.ngoId ==
              get(/databases/$(database)/documents/adoption_applications/$(userId)/animals/$(animalId)).data.ngoId)
          || (exists(/databases/$(database)/documents/animais/$(animalId))
            && get(/databases/$(database)/documents/animais/$(animalId)).data.status == 'disponivel'
            && request.resource.data.ngoId ==
              get(/databases/$(database)/documents/animais/$(animalId)).data.ong_id)
        );
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if (signedIn() && request.auth.uid == userId)
          || (isTeamMember()
            && exists(/databases/$(database)/documents/adoption_conversations/$(userId)/animals/$(animalId))
            && request.auth.token.ngoId ==
              get(/databases/$(database)/documents/adoption_conversations/$(userId)/animals/$(animalId)).data.ngoId);
        allow create: if signedIn()
          && existsAfter(/databases/$(database)/documents/adoption_conversations/$(userId)/animals/$(animalId))
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderRole', 'senderName', 'text', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && (
            (request.auth.uid == userId
              && request.resource.data.senderRole == 'user'
              && !('senderName' in request.resource.data.keys()))
            || (isTeamMember()
              && request.auth.token.ngoId ==
                getAfter(/databases/$(database)/documents/adoption_conversations/$(userId)/animals/$(animalId)).data.ngoId
              && request.resource.data.senderRole == 'team'
              && request.resource.data.senderName is string
              && request.resource.data.senderName.size() > 0
              && request.resource.data.senderName.size() <= 100)
          );
        allow update, delete: if false;
      }
    }

    match /metadata/reports_counter {
      allow read, write: if signedIn();
    }
  }
}
